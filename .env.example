# =============================================================================
# Environment variables
# -----------------------------------------------------------------------------
# 1. Copy this file to `.env` in the project root:  cp .env.example .env
# 2. Fill in the values below.
# 3. On Vercel, add the same keys under Project -> Settings -> Environment
#    Variables (Production + Preview + Development).
#
# IMPORTANT: Vite only exposes variables prefixed with `VITE_` to the browser.
# Anything in this file ends up in the client bundle, so never put a secret
# here. The Web3Forms access key is designed to be public — it is a
# submission-endpoint identifier, not a credential.
# =============================================================================

# -----------------------------------------------------------------------------
# Web3Forms — powers the contact form (https://web3forms.com)
# Create a free key at https://web3forms.com/#start and paste it here.
# -----------------------------------------------------------------------------
VITE_WEB3FORMS_ACCESS_KEY=0ad17684-15dc-4017-9537-57df5c08dd9a

# -----------------------------------------------------------------------------
# Canonical site URL — used for SEO canonical tags, Open Graph URLs, JSON-LD
# and sitemap generation. No trailing slash.
# -----------------------------------------------------------------------------
VITE_SITE_URL=https://shubhammodanwal.vercel.app

# -----------------------------------------------------------------------------
# Live Developer Dashboard data sources
# -----------------------------------------------------------------------------
# GitHub username (official public REST API — no token required).
VITE_GITHUB_USERNAME=shubham993616

# Optional. A GitHub fine-grained token with *no* scopes raises the public API
# rate limit from 60 to 5,000 requests/hour. Leave blank to run unauthenticated.
# WARNING: a token placed here is visible in the client bundle. Only ever use a
# token with zero permissions, or leave this empty.
VITE_GITHUB_TOKEN=

# LeetCode username. LeetCode has no official public API; the dashboard uses a
# community proxy and falls back to resume-verified figures if it is offline.
VITE_LEETCODE_USERNAME=imshubh4m

# Base URL of the community LeetCode stats proxy.
VITE_LEETCODE_API_BASE=https://leetcode-stats-api.herokuapp.com

# CodeChef username. CodeChef exposes no public API, so the dashboard renders
# resume-verified static figures for this platform (see README > Limitations).
VITE_CODECHEF_USERNAME=imshubh4m
